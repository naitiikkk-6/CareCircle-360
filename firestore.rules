rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CareCircle 360 Security Model:
    // ALL direct client SDK read and write access is denied.
    // The backend Node.js service (using Firebase Admin SDK / ADC) is the single source of truth
    // and enforces all circle permissions, role authorizations, and audit trails.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
