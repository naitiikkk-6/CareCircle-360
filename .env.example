# Server Configuration
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080
APP_SECRET=your-secure-random-32-byte-hex-string-for-tokens
DEFAULT_TIMEZONE=Asia/Kolkata

# Google Cloud & Firebase Configuration
FIREBASE_PROJECT_ID=carecircle-360-demo

# Google Gemini API (Server-side for MediGuide)
GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer / Gmail SMTP Configuration
# Use Gmail 2-Step Verification + App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-carecircle-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_FROM="CareCircle 360" <your-carecircle-email@gmail.com>

# Safe Mock Mode: logs emails to console/audit log instead of dispatching to SMTP (set to 'false' in production)
EMAIL_MOCK_MODE=true

# Cloud Scheduler & Cron Secret Header Token (Constant-time compared)
SCHEDULER_SECRET=carecircle-scheduler-secret-auth-key-here
CRON_SECRET=carecircle-scheduler-secret-auth-key-here
